# Home Assistant Docker Setup Configuration

# Home Assistant version (pinned for reproducibility)
# Check available versions at: https://github.com/home-assistant/core/releases
HA_VERSION=2024.12.0

# Path to external SSD or storage
# This is where Home Assistant configuration and data will be persisted
SSD_PATH=/mnt/ssd

# Home Assistant port (change if 8123 is already in use)
HA_PORT=8123
